# Copia este archivo a .env (o exporta las variables en tu plataforma).
# Ninguna es obligatoria: el servidor funciona con los valores por defecto.

# Puerto y dirección de escucha. Detrás de un proxy, mantén 0.0.0.0.
PORT=8080
HOST=0.0.0.0

# Dónde se guardan usuarios, sesiones y datos. DEBE ser persistente y estar
# FUERA del árbol de archivos servidos. Nunca lo versiones (ya está en .gitignore).
DATA_DIR=./data

# Pon 1 SOLO si el proceso recibe tráfico exclusivamente de un proxy de confianza
# (nginx, Caddy, Render, Fly...) que reescribe X-Forwarded-*. Si el puerto está
# expuesto directamente a Internet, déjalo en 0 para que un cliente no pueda
# falsificar esas cabeceras y evadir el límite de intentos.
TRUST_PROXY=0

# Opcional: origen público canónico (https://tu-dominio). Se usa como respaldo
# en la comprobación CSRF si tu proxy reescribe Host de una forma insólita.
# Normalmente no hace falta: el navegador envía Sec-Fetch-Site: same-origin.
# PUBLIC_ORIGIN=https://tu-dominio

# Anti-clickjacking. Por defecto 'none': la app NO puede ir en un iframe y se
# envía X-Frame-Options: DENY. Solo si tu vista previa/dashboard embebe el
# servidor en un iframe, pon * (NUNCA en producción con usuarios reales).
# FRAME_ANCESTORS=*

# --- Acceso exclusivo (usuario único) -------------------------------------
# Si se define, se CIERRA el registro público y solo esta cuenta puede entrar.
# El cliente oculta el alta de cuentas y el modo local: sin la clave no se
# puede usar la app en este despliegue (fail closed si el backend cae).
# USUARIO_UNICO=Chain
#
# Crea la cuenta UNA SOLA VEZ pasando la clave por stdin (nunca en un archivo):
#   printf '%s' 'TU_CLAVE' | DATA_DIR=./data USUARIO_UNICO=Chain \
#     node tools/crear-usuario.mjs Chain
# Para cambiarla mas adelante, añade --reset al final del comando.
