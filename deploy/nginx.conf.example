# Reverse proxy HTTPS para Gestor de Pagos. PLANTILLA: sustituye el dominio y
# las rutas de certificado. Detrás de este proxy, arranca el servidor con
# TRUST_PROXY=1 para que las cookies lleven el flag Secure y el rate limit
# use la IP real del cliente.
#
#   server_name  TU_DOMINIO;
#   ssl_certificate      /etc/letsencrypt/live/TU_DOMINIO/fullchain.pem;
#   ssl_certificate_key  /etc/letsencrypt/live/TU_DOMINIO/privkey.pem;

server {
    listen 80;
    server_name TU_DOMINIO;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name TU_DOMINIO;

    ssl_certificate     /etc/letsencrypt/live/TU_DOMINIO/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/TU_DOMINIO/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Coincide con BODY_LIMIT del servidor (2 MB).
    client_max_body_size 2m;

    # El backend ya envía CSP (frame-ancestors), X-Frame-Options, nosniff,
    # Referrer-Policy, Permissions-Policy, COOP/CORP y HSTS. No las dupliques.
    location / {
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   Connection        "";
        proxy_read_timeout 30s;
    }

    location /api/ {
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   Connection        "";
        proxy_buffering    off;
        proxy_no_cache     1;
        proxy_cache_bypass 1;
        add_header         Cache-Control "no-store" always;
    }
}
